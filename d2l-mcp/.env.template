# D2L Brightspace Configuration
D2L_HOST=learn.yourschool.edu
D2L_COURSE_ID=                    # Optional: default course ID for tools
D2L_USERNAME=                     # Optional: for automated login
D2L_PASSWORD=                     # Optional: for automated login

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Piazza Integration (optional)
PIAZZA_USERNAME=your-email@school.edu
PIAZZA_PASSWORD=your-piazza-password

# OpenAI (required for semantic search embeddings)
OPENAI_API_KEY=sk-your-openai-api-key

# S3 (required for browser state persistence)
S3_BUCKET=your-bucket-name
AWS_REGION=us-east-1

# KMS (required — used for password encryption and S3 storage-state encryption)
# Create a KMS symmetric key in AWS Console → KMS → Customer-managed keys
# Then attach kms:Encrypt, kms:Decrypt, kms:GenerateDataKey to the ECS task IAM role
KMS_KEY_ARN=arn:aws:kms:us-east-1:ACCOUNT_ID:key/KEY_ID

# Cognito (optional, for mobile app auth)
COGNITO_USER_POOL_ID=your-pool-id
COGNITO_CLIENT_ID=your-client-id

# Server
API_HOST=your-domain.com
MCP_TRANSPORT=http
MCP_PORT=3000

# MCP bearer token (required — no unauthenticated mode)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
STUDY_MCP_TOKEN=your-mcp-token

# ── OAuth 2.1 for the /mcp transport (secondary auth method) ──────────────────
# Public base URL used to build OAuth discovery metadata and the /mcp
# WWW-Authenticate resource_metadata pointer. Defaults to https://<API_HOST>.
PUBLIC_BASE_URL=https://your-domain.com

# HMAC secret that signs the short-lived interim authorization-request blob
# carried between the login page and the consent POST. RECOMMENDED in prod for
# secret separation; if unset, falls back to STUDY_MCP_TOKEN (OAuth still works).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# OAUTH_SESSION_SECRET=your-oauth-session-secret

# Optional token lifetimes (seconds). Defaults: 900 / 2592000 / 60.
# OAUTH_ACCESS_TOKEN_TTL=900
# OAUTH_REFRESH_TOKEN_TTL=2592000
# OAUTH_AUTH_CODE_TTL=60

# Dev mode (local only — never set these in production)
# SKIP_JWT_AUTH=1
# MCP_USER_ID=test-user
